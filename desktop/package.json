{
  "name": "lineuplab-desktop",
  "version": "1.0.0",
  "description": "LineupLab for Windows \u2014 browse football matches, lineups and ratings, and build custom XIs.",
  "private": true,
  "author": "LineupLab",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && npm run build:preload && cross-env LINEUPLAB_DEV_SERVER=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.mts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scare-1234/Lineups.git",
    "directory": "desktop"
  },
  "homepage": "https://github.com/scare-1234/Lineups"
}
